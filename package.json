{
  "name": "cms-contractor",
  "version": "0.1.0",
  "description": "Simple customer management system for contractors",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite",
    "client:build": "vite build",
    "client:preview": "vite preview",
    "server:dev": "nodemon server.js",
    "start": "npm run client:build && node server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "vue": "^3.3.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  }
}
