# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Drizzle
# @type=url
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cms_contractor

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
# @sensitive
BETTER_AUTH_SECRET=""
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github

GITHUB_CLIENT_ID=""
# @sensitive
GITHUB_CLIENT_SECRET=""

# Support / feedback → GitHub Issues
# The in-app support page files contractor feedback as issues on this repo.
# Format: "owner/repo" (e.g. "acme/contractor-crm"). Leave blank to disable the
# support form (it degrades to a friendly "not configured" message).
GITHUB_REPO=""
# A token with permission to create issues on GITHUB_REPO — a fine-grained PAT
# with Issues: Read and write, or a classic token with the `repo` scope.
# @sensitive
GITHUB_TOKEN=""
# Labels applied to filed issues, by feedback type. These labels should already
# exist on the repo.
GITHUB_LABEL_BUG="bug"
GITHUB_LABEL_FEATURE="enhancement"
